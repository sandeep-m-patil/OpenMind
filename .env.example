# Copy this file to .env and fill in values.  .env is git-ignored — never commit it.
#   PowerShell:  Copy-Item .env.example .env
# Everything works with the defaults below; API keys are OPTIONAL upgrades.

# ---- product-api stack --------------------------------------------------
POSTGRES_USER=opsmind
# Local-only dev password. Use letters/digits/dashes only (it is embedded in a URL).
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=shop

# ---- Host ports (change any that are already used on your machine) -----
PRODUCT_API_PORT=8001
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
BACKEND_PORT=8002
DASHBOARD_PORT=3002
HINDSIGHT_API_PORT=8888
HINDSIGHT_UI_PORT=9999
JENKINS_PORT=8081

# ---- Monitoring ---------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=changeme-local-only

# ---- LLM (optional). Without keys OpsMind uses its deterministic rule engine.
# Gemini key: https://aistudio.google.com/apikey   Groq key: https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Hindsight memory ---------------------------------------------------
HINDSIGHT_BANK=opsmind-sre
# "none" = no API key needed (memories stored verbatim, recalled by semantic + keyword search).
# Set to gemini or groq (+ key + model) to enable LLM fact extraction inside Hindsight.
HINDSIGHT_LLM_PROVIDER=none
HINDSIGHT_LLM_API_KEY=
HINDSIGHT_LLM_MODEL=

# ---- Slack (optional). Without tokens, approve in the dashboard. See docs/setup.md §Slack.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# ---- Jenkins (optional profile: docker compose --profile cicd up -d jenkins)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=changeme-local-only
