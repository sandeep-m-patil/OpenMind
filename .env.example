# Copy this file to .env and fill in values.  .env is git-ignored — never commit it.
#   PowerShell:  Copy-Item .env.example .env

# ---- Phase 1: product-api stack ----------------------------------------
POSTGRES_USER=opsmind
# Local-only dev password. Use letters/digits only (it is embedded in a URL).
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=shop

# Host ports (change if something else on your machine already uses them)
PRODUCT_API_PORT=8001
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# ---- Later phases (leave blank for now) --------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
